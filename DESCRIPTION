Type: Package
Package: richCluster
Title: Fast, Robust Clustering Algorithms for Gene Enrichment Data
Version: 2.0.1
Date: 2026-09-18
Authors@R: c(
    person("Junguk", "Hur", , "hurlabshared@gmail.com", role = c("aut", "cre"),
           comment = c(ORCID = "0000-0002-0736-2149")),
